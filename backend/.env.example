# ==========================================================================
#  SMART RESTAURANT — backend
#  Hosting: cPanel shared (PHP 8.3 / ea-php83, MySQL 8.0.44, utf8mb4)
#  Redis YO'Q · Reverb YO'Q · Supervisor YO'Q — qarang docs/05-PHASE0-PLAN.md
# ==========================================================================

APP_NAME="Smart Restaurant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Ko'rsatish uchun timezone restaurants.timezone dan olinadi (Asia/Tashkent).
# DB da hamma vaqt UTC saqlanadi — APP_TIMEZONE ni o'zgartirmang.

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# --------------------------------------------------------------------------
# LOG — 1 GB disk byudjeti: kunlik fayl, 7 kun saqlanadi
# --------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# DATABASE — MySQL 8.0.44, utf8mb4
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_restaurant
# cPanel'da user nomi avtomatik prefiks oladi: cpaneluser_smartrest
DB_USERNAME=smart_restaurant
DB_PASSWORD=

# Test bazasi (phpunit.xml dan ishlatiladi). SQLite ISHLATILMAYDI —
# generated column, lockForUpdate va DECIMAL xatti-harakati MySQL'ga bog'liq.
DB_TEST_DATABASE=smart_restaurant_test

# --------------------------------------------------------------------------
# CACHE / QUEUE / SESSION — Redis yo'q, hammasi `database` driver
# `cache_locks` jadvali atomic lock va rate limiting uchun ishlatiladi
# --------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# cPanel cron (PHASE 16):
#   * * * * * cd ~/apps/backend && php artisan schedule:run >> /dev/null 2>&1
#   * * * * * cd ~/apps/backend && php artisan queue:work --stop-when-empty --max-time=55 >> /dev/null 2>&1

# --------------------------------------------------------------------------
# BROADCAST — Pusher Channels (Reverb cPanel'da ishlamaydi)
# Akkaunt PHASE 9 da yaratiladi. Bo'sh bo'lsa broadcast o'chadi, tizim ishlayveradi.
# --------------------------------------------------------------------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_SCHEME=https
PUSHER_PORT=443

# Frontend (Vite) uchun ham shu kalitlar kerak — frontend/*/.env ga qarang.

# --------------------------------------------------------------------------
# STORAGE — rasm DB da saqlanmaydi, faqat URL (docs/01 §13)
# --------------------------------------------------------------------------
FILESYSTEM_DISK=public

# 1 GB disk byudjeti — ImageService shu limitlarni qo'llaydi
SR_IMAGE_MAX_WIDTH=1200
SR_IMAGE_MAX_KB=300
SR_IMAGE_FORMAT=webp

# --------------------------------------------------------------------------
# BIZNES SOZLAMALARI (docs/05-PHASE0-PLAN.md §5 javoblari)
# --------------------------------------------------------------------------
# Draft order yashash muddati (daqiqa). Muddati o'tgani EXPIRED bo'ladi.
SR_DRAFT_TTL_MINUTES=120
# Customer order status ekrani polling intervali (soniya) — Pusher connection tejaladi
SR_CUSTOMER_POLL_SECONDS=4
# Afitsant chaqiruvi spam himoyasi (daqiqa)
SR_WAITER_CALL_COOLDOWN_MINUTES=2

# --------------------------------------------------------------------------
# CORS / FRONTEND — subdomain sxemasi (docs/05 §1)
# --------------------------------------------------------------------------
FRONTEND_CUSTOMER_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
FRONTEND_WAITER_URL=http://localhost:5175
CORS_ALLOWED_ORIGINS="${FRONTEND_CUSTOMER_URL},${FRONTEND_ADMIN_URL},${FRONTEND_WAITER_URL}"

MAIL_MAILER=log
